# PostgreSQL connection string (developed against Neon — https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Web Push VAPID keypair — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret checked against the Authorization header on the cron sweep
# endpoint — required, the endpoint fails closed if this is unset.
CRON_SECRET=""
